# Skopiuj do .env i uzupełnij (plik .env jest w .gitignore — NIGDY nie commituj sekretów)
# Moduł szacowania posiłków ze zdjęć — wystarczy JEDEN z kluczy:
# Gemini (Google AI Studio, darmowy tier): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=AIza...
# albo Claude API (płatny, pay-as-you-go): https://platform.claude.com
# ANTHROPIC_API_KEY=sk-ant-...

# Wybór backendu: auto (domyślnie: gemini przy kluczu usera → vertex, gdy jest
# projekt → gemini z env → claude) | claude | gemini | vertex
# FIT_KRASNAL_LLM=auto
# Vertex AI: Gemini z konta serwera (Application Default Credentials, rola
# roles/aiplatform.user) — bez kluczy API. Region domyślnie europe-west1 (UE).
# FIT_KRASNAL_VERTEX_PROJECT=moj-projekt-gcp
# FIT_KRASNAL_VERTEX_LOCATION=europe-west1

# Opcjonalnie: katalog na dane runtime (domyślnie ./data — poza repo)
# FIT_KRASNAL_DATA=/sciezka/do/danych

# Opcjonalnie: katalog tokenów sesji Garmina (domyślnie ~/.fit-krasnal/garth — poza repo)
# GARMINTOKENS=~/.fit-krasnal/garth

# ── Logowanie (wdrożenie publiczne) ──────────────────────────────────────────
# WYMAGANE w produkcji: klucz podpisujący ciasteczko sesji. Wygeneruj własny:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Bez tego działa jawnie niebezpieczna wartość domyślna (tylko do dev).
# FIT_KRASNAL_SECRET_KEY=...

# Wspólny kod zaproszenia do rejestracji. Nieustawiony = rejestracja wyłączona.
# FIT_KRASNAL_INVITE_CODE=...

# Klucz szyfrujący sekretów użytkownika (klucze LLM, tokeny Garmina) — Fernet.
# W dev bez tej zmiennej działa (klucz wyprowadzony z FIT_KRASNAL_SECRET_KEY,
# tylko gdy FIT_KRASNAL_DEBUG=1) — W PRODUKCJI WYMAGANE, proces bez niego nie
# wstanie. Wygeneruj:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIT_KRASNAL_ENC_KEY=...

# ── Logowanie przez Google (OIDC) — opcjonalny wariant wdrożenia ─────────────
# Tryb: password (domyślnie, e-mail + hasło) | oidc (tylko Google) | both.
# FIT_KRASNAL_AUTH=password
# Klient OAuth 2.0 z Google Cloud Console (typ „Web application"); adres zwrotny:
#   <FIT_KRASNAL_PUBLIC_URL>/auth/google/callback
# FIT_KRASNAL_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# FIT_KRASNAL_GOOGLE_CLIENT_SECRET=...
# Kto może wejść (małe litery, po przecinku). Konto spoza listy dostaje 403.
# FIT_KRASNAL_ALLOWED_EMAILS=osoba@example.com
# Publiczny adres aplikacji (do adresów zwrotnych OAuth), np. https://fit-<ip>.sslip.io
# FIT_KRASNAL_PUBLIC_URL=https://...

# Dev na http://localhost (bez HTTPS) — pozwala ciasteczku sesji działać.
# W produkcji ZOSTAW WYŁĄCZONE (ciasteczko tylko po HTTPS).
# FIT_KRASNAL_DEBUG=1
